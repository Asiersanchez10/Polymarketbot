# Polymarket CLOB API Configuration
# Base URL for the Polymarket CLOB API
CLOB_API_URL=https://clob.polymarket.com

# Your Polygon wallet private key (without 0x prefix)
# NEVER commit your real private key to version control
PRIVATE_KEY=your_private_key_here

# Polygon chain ID (137 for mainnet, 80001 for Mumbai testnet)
CHAIN_ID=137

# Optional: API key for authenticated endpoints (obtained via /auth/api-key)
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Trading Configuration
# Minimum profit percentage to consider an opportunity (e.g., 0.5 = 0.5%)
MIN_PROFIT_PCT=0.5

# Maximum position size as percentage of portfolio (e.g., 5 = 5%)
MAX_POSITION_PCT=5.0

# Maximum total exposure as percentage of portfolio (e.g., 50 = 50%)
MAX_EXPOSURE_PCT=50.0

# Maximum number of concurrent open positions
MAX_CONCURRENT_POSITIONS=10

# Polymarket fee rate (approximately 2% total)
FEE_RATE=0.02

# Mock Mode - set to true to run without real funds using simulated data
MOCK_MODE=true

# Dashboard Configuration
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0

# Database path
DATABASE_URL=sqlite+aiosqlite:///./polymarket_bot.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Scan interval in seconds
SCAN_INTERVAL=30

# Initial portfolio value in USDC (for mock mode)
INITIAL_PORTFOLIO=1000.0
